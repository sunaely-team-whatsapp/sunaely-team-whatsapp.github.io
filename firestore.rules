rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Único administrador: tu UID de Firebase Authentication.
    // Aunque alguien consiga crear una cuenta, solo este UID puede escribir.
    function isAdmin() {
      return request.auth != null && request.auth.uid == '06m6pjSiPgNUTO1Qrmb4oO9zlqH2';
    }

    // Listas: todos leen, solo el admin escribe
    match /ocupados/{docId}   { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /reservados/{docId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /buscados/{docId}   { allow read: if true; allow create, update, delete: if isAdmin(); }

    // Ajustes sueltos (lobby: link, nombre y foto): todos leen, solo el admin escribe
    match /ajustes/{docId}    { allow read: if true; allow write: if isAdmin(); }

    // Páginas del índice (visibilidad): todos leen, solo el admin cambia
    match /paginas/{docId}    { allow read: if true; allow create, update, delete: if isAdmin(); }

    // Para las próximas páginas (árbol genealógico y registros de mensajes)
    match /arbol/{docId}      { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /registros/{docId}  { allow read: if true; allow create, update, delete: if isAdmin(); }

    // Miembros (teléfonos/usuarios de WhatsApp): SOLO el admin, ni para leer
    match /miembros/{docId}   { allow read, write: if isAdmin(); }

    // Todo lo demás queda denegado por defecto
  }
}
